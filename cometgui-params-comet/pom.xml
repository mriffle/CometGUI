<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cometgui</groupId>
    <artifactId>cometgui-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cometgui-params-comet</artifactId>
  <packaging>jar</packaging>
  <name>CometGUI :: Comet parameters</name>
  <description>Typed, versioned, validated model of the 118 Comet parameters, with parser, writer, presets and migration.</description>

  <!--
    COVERAGE GATE ON, CURRENTLY INERT (phase 01 unit 3).  The specification
    gates "parameter ... logic" at >= 90% line and >= 85% branch.  The module holds only
    package-info classes today, which carry no LINE or BRANCH counters, so
    JaCoCo has no ratio to violate and the rule cannot fail: it is switched on
    and inert, which is not the same as passing.  The phase that fills this
    module inherits a live gate rather than having to remember to add one, and
    scripts/build.sh fails the build if real classes appear here while the
    switch is still true.

    LIVE SINCE PHASE 06 UNIT 2, which put the first real classes here
    (org.cometgui.params.comet.schema and .parser).  From that commit the JaCoCo
    rule above has counters to judge, and the MUTATION gate is switched on too
    (decision D6-5, handoffs/PHASE-06-worklog.rst): >= 80% of PIT's mutants over
    org.cometgui.params.comet.* must be killed.  Nothing in the parent POM's PIT
    configuration was changed to do it.
  -->
  <properties>
    <cometgui.coverage.core.skip>false</cometgui.coverage.core.skip>
    <cometgui.mutation.skip>false</cometgui.mutation.skip>
  </properties>

  <!--
    Only the edges the specification's layering permits are declared here.
    Adding one is an architectural change: say so in the phase handoff, and
    expect the ArchUnit rules in cometgui-archtests to have an opinion.
  -->
  <dependencies>
    <dependency>
      <groupId>org.cometgui</groupId>
      <artifactId>cometgui-domain</artifactId>
    </dependency>
    <!--
      Phase 06 decision D6-2 (handoffs/PHASE-06-worklog.rst): the curated
      parameter metadata, and in tests the artefact manifest, are read with the
      project's one JSON reader, org.cometgui.provenance.json.JsonReader, not a
      second one.  The same edge cometgui-install already has; no cycle is
      possible, since cometgui-provenance depends only on cometgui-domain.
    -->
    <dependency>
      <groupId>org.cometgui</groupId>
      <artifactId>cometgui-provenance</artifactId>
    </dependency>
    <!--
      Phase 06 decision D6-3: TEST scope only.  The fixture tests run the real
      pinned Comet binary through the one process launcher,
      org.cometgui.tools.process.ProcessService.  Main code reaches processes
      only through the domain ProcessRunner port and never names this module.
    -->
    <dependency>
      <groupId>org.cometgui</groupId>
      <artifactId>cometgui-process</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
