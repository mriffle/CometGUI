<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cometgui</groupId>
    <artifactId>cometgui-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cometgui-params-percolator</artifactId>
  <packaging>jar</packaging>
  <name>CometGUI :: Percolator parameters</name>
  <description>Typed model and validation of the Percolator options CometGUI exposes.</description>

  <!--
    COVERAGE GATE ON, AND LIVE (phase 01 unit 3; filled by phase 09 unit 2).
    The specification gates "parameter ... logic" at >= 90% line and >= 85%
    branch.  Phase 09 put the Percolator settings, their validation and the
    latest-compatible resolver here, so JaCoCo now has real LINE and BRANCH
    counters to check and the rule can fail.  It is met by tests, never by an
    exclusion.

    MUTATION GATE ON (phase 09 unit 2).  org.cometgui.params.percolator.* is
    one of the parent POM's PIT target packages (R-TEST-02), and
    scripts/build.sh fails the build when a module compiles real classes in a
    critical package while its switch is still true.  This is the module's own
    switch, the parent POM's documented mechanism; PIT's configuration is
    unchanged.
  -->
  <properties>
    <cometgui.coverage.core.skip>false</cometgui.coverage.core.skip>
    <cometgui.mutation.skip>false</cometgui.mutation.skip>
  </properties>

  <!--
    Only the edges the specification's layering permits are declared here.
    Adding one is an architectural change: say so in the phase handoff, and
    expect the ArchUnit rules in cometgui-archtests to have an opinion.
  -->
  <dependencies>
    <dependency>
      <groupId>org.cometgui</groupId>
      <artifactId>cometgui-domain</artifactId>
    </dependency>
  </dependencies>
</project>
