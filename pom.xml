<?xml version="1.0" encoding="UTF-8"?>
<!--
  CometGUI - parent POM (Phase 01, work unit 1).

  This is the real product build.  The throwaway feasibility POMs under
  scripts/feasibility/ are not, and must never be promoted into it.

  Two facts inherited from Phase 00 that must not be undone:

  * There is NO org.openjfx:javafx-* dependency anywhere.  JavaFX 25.0.4+1 is
    bundled in the pinned BellSoft Liberica JDK 25.0.4.1+1 as resolved system
    modules; a Maven JavaFX dependency would put a second copy of the javafx.*
    packages on the class path.  cometgui-ui and cometgui-app compile against
    the bundled modules with no extra compiler argument - verified in this
    unit, see cometgui-ui/.../JavaFxAvailability.java.
  * The local repository is forced to _build/m2repo by .mvn/maven.config, so
    that no mvn invocation from this repository writes to the host's ~/.m2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cometgui</groupId>
  <artifactId>cometgui-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CometGUI</name>
  <description>
    Cross-platform JavaFX desktop application that runs a complete
    Comet to Percolator proteomics search workflow, installs every scientific
    tool it needs by itself, and produces a provenance record strong enough to
    reproduce the run later.
  </description>
  <inceptionYear>2026</inceptionYear>

  <!--
    Licence declaration only.  The LICENSE file itself is placed by another
    Phase 01 work unit; D-001 records the decision (GPL-3.0-only, derived from
    CasanovoGUI).
  -->
  <licenses>
    <license>
      <name>GNU General Public License v3.0 only</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
      <distribution>repo</distribution>
      <comments>SPDX-License-Identifier: GPL-3.0-only (see DECISIONS.rst, D-001)</comments>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      maven.compiler.release, not source/target: it is the stricter of the two
      and this unit verified that javac still resolves the JDK-bundled javafx.*
      system modules under it, with no extra add-modules argument.  (XML
      comments cannot contain a double hyphen, so javac option names appear
      here without their leading hyphens.)  The feasibility gui-spike needed
      source/target only because it also passes add-exports at internal
      com.sun.* packages, which the release option forbids.  A module that
      later needs add-exports must override these properties locally and say
      why in its own POM.
    -->
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Minimum toolchain, enforced at validate by maven-enforcer-plugin. -->
    <cometgui.minimumMavenVersion>3.9.16</cometgui.minimumMavenVersion>
    <cometgui.minimumJavaVersion>25</cometgui.minimumJavaVersion>

    <!--
      Test libraries.  JUnit 5.14.4 is the version Phase 00 proved on this JDK
      (scripts/feasibility/gui-spike).  Do not move to JUnit 6 without
      re-proving the pitest JUnit 5 plugin against it first - unit 3 gates on
      PIT.
    -->
    <junit.version>5.14.4</junit.version>

    <!--
      Build-plugin versions.  Every plugin used anywhere in this build is
      pinned to an exact version here; no ranges, no reliance on the Maven
      defaults.  Versions were checked against Maven Central metadata on
      2026-08-29 and each is exercised by `bash scripts/build.sh`.
    -->
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>

    <!--
      Formatting and static analysis (unit 2).  Three tools, six pins: the
      Maven plugin and the analyser it drives are versioned independently, and
      pinning only the plugin would let the analyser float.
    -->
    <spotless-maven-plugin.version>3.10.1</spotless-maven-plugin.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <puppycrawl-checkstyle.version>14.0.0</puppycrawl-checkstyle.version>
    <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
    <spotbugs-core.version>4.10.4</spotbugs-core.version>

    <!--
      UNIT 3: TEST, COVERAGE, ARCHITECTURE AND MUTATION GATES.  Each version
      below was chosen by running it on this JDK (Liberica 25.0.4.1+1, class
      file major version 69) and reading its output, not from a changelog.
      A coverage or mutation tool that cannot read a class file reports an
      empty analysis and exits 0, which is the exact failure this project
      calls a vacuous pass.
    -->
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <pitest-maven.version>1.30.0</pitest-maven.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <archunit.version>1.5.0</archunit.version>
    <!--
      Headless JavaFX.  The pinned Liberica JDK bundles JavaFX 25.0.4+1 but
      ships NO Monocle: com.sun.glass.ui contains only .gtk and .delegate, and
      this host has no libX11, so there is no usable Glass platform in the box.
      org.testfx:openjfx-monocle supplies one; it is fetched by
      maven-dependency-plugin and injected with the patch-module option in
      cometgui-ui, never placed on the class path.  Phase 00 unit 7 proved this
      exact pair (scripts/feasibility/javafx-smoke.sh).
    -->
    <openjfx-monocle.version>21.0.2</openjfx-monocle.version>

    <!--
      COVERAGE GATE SWITCHES (unit 3).  The thresholds themselves are written
      once, in the jacoco pluginManagement block below, so that no module can
      hold a different number.  A module opts in by overriding one of these to
      false in its own POM; the default is "no numeric gate", which is what the
      specification says for adapters and for JavaFX rendering glue.

        cometgui.coverage.core.skip       the specification's "core domain,
                                          parameter and provenance logic":
                                          90% line, 85% branch, whole module.
        cometgui.coverage.viewmodel.skip  "UI-independent view-model and
                                          presenter logic": 80% line, scoped
                                          to the view-model packages.
        cometgui.mutation.skip            R-TEST-02: 80% mutation score over
                                          the critical packages.

      scripts/build.sh re-derives which modules SHOULD be opted in from the
      classes actually compiled, and fails if a module grows gated code while
      its switch is still true.  Flipping a switch back to true to make a build
      pass is a weakening of a gate.
    -->
    <cometgui.coverage.core.skip>true</cometgui.coverage.core.skip>
    <cometgui.coverage.viewmodel.skip>true</cometgui.coverage.viewmodel.skip>
    <cometgui.mutation.skip>true</cometgui.mutation.skip>

    <!--
      Surefire argument plumbing.  jacoco:prepare-agent writes the agent option
      into cometgui.jacocoArgLine (renamed from the default argLine so that a
      module setting its own argLine cannot silently drop the coverage agent -
      an agent-less test run produces no execution data and JaCoCo then reports
      100% of nothing).  Surefire reads it back late, with the at-sign form, so
      the value exists by the time tests fork.  The empty defaults here are
      what makes the late reference resolvable when a goal is skipped.
    -->
    <cometgui.jacocoArgLine/>
    <cometgui.surefire.extraArgLine/>

    <!--
      Where the hand-written rule sets live.  maven.multiModuleProjectDirectory
      is the repository root for every module in the reactor (Maven sets it
      because .mvn/ exists here); a plain relative path would resolve against
      each module's own basedir and only work in the parent.
    -->
    <cometgui.configDirectory>${maven.multiModuleProjectDirectory}/config</cometgui.configDirectory>
  </properties>

  <!--
    Module order is dependency order: a module never appears before something
    it depends on.  Maven would reorder anyway; keeping it readable is for the
    humans and agents who have to reason about the layering.
  -->
  <modules>
    <module>cometgui-domain</module>
    <module>cometgui-provenance</module>
    <module>cometgui-process</module>
    <module>cometgui-tools</module>
    <module>cometgui-install</module>
    <module>cometgui-params-comet</module>
    <module>cometgui-params-percolator</module>
    <module>cometgui-results</module>
    <module>cometgui-workflow</module>
    <module>cometgui-ui</module>
    <module>cometgui-app</module>
    <module>cometgui-archtests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Test stack. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        Architecture tests.  Only cometgui-archtests declares it; it is managed
        here so the version is pinned in the same place as everything else.
        1.5.0 is the version seen to import Java 25 class files (major version
        69) in this reactor: an ArchUnit that cannot read a class file imports
        nothing and every rule then passes vacuously, which is why
        cometgui-archtests asserts the size and the composition of its import
        before it checks a single rule.
      -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>

      <!--
        Reactor modules, so that a child declares a sibling without repeating
        a version.  The permitted edges are listed in each child POM; the
        layering they encode becomes an enforced ArchUnit rule in unit 3.
      -->
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-provenance</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-process</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-tools</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-install</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-params-comet</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-params-percolator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-results</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-workflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cometgui</groupId>
        <artifactId>cometgui-app</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Every module gets JUnit Jupiter: a module with no test is a module with
      no gate, and this project does not accept one.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!--
              UNIT 3.  Two things, both of which exist to stop a test run that
              proves nothing.

              argLine: the at-sign form is surefire's LATE property reference,
              resolved when the fork is created rather than when the POM is
              read, which is the only form that can pick up the value
              jacoco:prepare-agent writes during the build.  A module that needs
              its own JVM options sets cometgui.surefire.extraArgLine (see
              cometgui-ui) instead of overriding argLine, so that the coverage
              agent can never be dropped by accident.  Drop the agent and every
              module reports no execution data, and JaCoCo passes a rule it
              never evaluated.

              cometgui.buildDirectory: tests that must leave evidence on disk
              for scripts/build.sh to read (the ArchUnit import census) need the
              module's target directory; surefire's working directory is the
              module basedir, and hard-coding "target" in a test would break the
              moment a module moved its build output.
            -->
            <argLine>@{cometgui.jacocoArgLine} ${cometgui.surefire.extraArgLine}</argLine>
            <systemPropertyVariables>
              <cometgui.buildDirectory>${project.build.directory}</cometgui.buildDirectory>
            </systemPropertyVariables>
          </configuration>
        </plugin>

        <!--
          UNIT 2: FORMATTING AND STATIC ANALYSIS.  All three fail `mvn verify`
          on a violation; none of them is advisory.  Their executions are in
          <build><plugins> below.
        -->

        <!--
          Spotless owns layout, imports, whitespace and the licence header.

          FORMATTER CHOICE (google-java-format 1.36.1, AOSP style), and how it
          was chosen: by running it on this JDK, not by reputation.
          google-java-format reaches into jdk.compiler internals, which are not
          exported on JDK 25.  Spotless can force them open itself, but it does
          so through sun.misc.Unsafe::staticFieldBase, which this JVM reports as
          terminally deprecated and slated for removal: a build that would one
          day break for a reason nobody would connect to the formatter.  So the
          five add.exports options it needs are declared in .mvn/jvm.config
          instead (XML comments cannot contain a double hyphen, hence the dot);
          Spotless then sees the packages are already open, takes the supported
          path, and the deprecation warning disappears.  AOSP style (4-space
          indent, 100 columns) was chosen because it is what the phase 00 and
          unit 1 sources were already written in, so adopting the formatter
          reflowed Javadoc but changed no code layout.
          The Eclipse JDT formatter was the fallback if that had failed: it
          needs no JDK internals, but it would have needed its own exported
          configuration file to maintain.  It was not needed.
        -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <!--
                PHASE 02 MUST EXTEND THIS, NOT RELAX IT.  Phase 02 adds files
                derived from Noble.Lab/CasanovoGUI, which by D-001 obligation 2
                must keep their upstream copyright notices.  Those files
                therefore need a *second* file set: exclude their paths from
                this <java> block and add a <formats><format> entry that
                includes them, with its own <licenseHeader> carrying the
                upstream notice plus CometGUI's derivation record.  Deleting
                the licenseHeader step, widening this header until it matches
                both, or excluding the derived tree from the check entirely are
                all weakenings of a gate and are rejected at sign-off.
              -->
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>AOSP</style>
              </googleJavaFormat>
              <!-- Static imports first, then everything else, each group
                   alphabetical: the order the phase 00 sources already use. -->
              <importOrder>
                <order>\#,</order>
              </importOrder>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
              <!--
                GPL-3.0 notice on every file this project authors (D-001).  A
                short notice naming the project and pointing at LICENSE, as the
                GPL's own "How to Apply These Terms" section describes, and not
                the full licence text, which lives once, at the repository root.
                The delimiter matches either `package` or the start of a Javadoc
                block, so that package-info.java keeps its Javadoc: with the
                default `package` delimiter Spotless replaces everything before
                the package statement, which would delete it.
              -->
              <licenseHeader>
                <file>${cometgui.configDirectory}/license/java-header.txt</file>
                <delimiter>(package|/\*\*)</delimiter>
              </licenseHeader>
            </java>
          </configuration>
        </plugin>

        <!--
          Checkstyle: the defects and naming rules a formatter cannot know.  The
          rule set is this project's own (config/checkstyle/checkstyle.xml) and
          every module in it is justified there; sun_checks.xml was rejected
          because its layout rules contradict google-java-format.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <!-- The plugin ships an older Checkstyle; pin the analyser too, or
                 the rules are graded by whatever version happens to be
                 bundled. -->
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${puppycrawl-checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>${cometgui.configDirectory}/checkstyle/checkstyle.xml</configLocation>
            <!-- Exposed to the rule set as ${checkstyle.header.file}; the same
                 file Spotless inserts, so the two tools cannot disagree about
                 what the licence header is. -->
            <headerLocation>${cometgui.configDirectory}/license/java-header.txt</headerLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>error</violationSeverity>
            <failsOnError>true</failsOnError>
            <linkXRef>false</linkXRef>
            <inputEncoding>UTF-8</inputEncoding>
            <!-- checkstyle-result.xml names every file inspected;
                 scripts/build.sh reads it to prove the analysis was not
                 vacuous. -->
            <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
            <outputFileFormat>xml</outputFileFormat>
          </configuration>
        </plugin>

        <!--
          SpotBugs reads bytecode, and this project compiles to Java 25 class
          files (major version 69).  4.10.4 reads them: verified on
          cometgui-domain, which reported total_classes=8, missingClasses=0,
          errors=0.  That is the check that matters, because an analyser that
          cannot read a class file quietly analyses nothing and exits 0.
          scripts/build.sh re-checks those numbers on every build for that
          reason.  If a future JDK bump ever outruns SpotBugs, the answer is to
          leave SpotBugs out with a comment and report it, never to lower
          maven.compiler.release to give the analyser something older to read.

          effort=Max, threshold=Low: the strictest pair SpotBugs offers, chosen
          while the tree is nearly empty so that no later phase inherits a bug
          the gate was never sensitive enough to see.  A finding that is wrong
          about this code becomes a narrow, justified entry in
          config/spotbugs/exclude.xml; raising the threshold is a weakening.
        -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.github.spotbugs</groupId>
              <artifactId>spotbugs</artifactId>
              <version>${spotbugs-core.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <effort>Max</effort>
            <threshold>Low</threshold>
            <failOnError>true</failOnError>
            <includeTests>true</includeTests>
            <xmlOutput>true</xmlOutput>
            <excludeFilterFile>${cometgui.configDirectory}/spotbugs/exclude.xml</excludeFilterFile>
          </configuration>
        </plugin>

        <!--
          UNIT 3: COVERAGE.  JaCoCo measures every module (coverage is a
          diagnostic everywhere) and gates the modules the specification names.

          THE NUMBERS ARE THE SPECIFICATION'S, and they are written here once so
          that no module can hold a different pair.  specification.rst, Testing
          Strategy / Coverage: "core domain, parameter and provenance logic
          >= 90% line and >= 85% branch; UI-independent view-model and presenter
          logic >= 80% line; adapters covered by real integration tests rather
          than artificial line counts; JavaFX rendering glue has no numeric
          target".  That is why there are exactly two check executions and why
          the adapter, install, workflow and app modules have neither.

          WHICH RULES BITE TODAY.  Only cometgui-domain has behaviour, so only
          its BUNDLE rule can currently fail.  The same rule is switched on in
          cometgui-provenance, cometgui-params-comet and cometgui-params-
          percolator, where it is INERT until those modules have classes: a
          module whose only classes are package-info carries no LINE or BRANCH
          counters at all, and JaCoCo cannot violate a ratio it cannot compute.
          An inert rule is not a passing rule.  scripts/build.sh prints the
          measured counters per module so the difference is visible, and fails
          if a module grows gated code with its switch still off.

          NO EXCLUSIONS.  There is no <excludes> here and adding one to make a
          module pass is a weakening of a gate.  If a class genuinely cannot be
          covered (a main method, a JavaFX bootstrap), that is an argument for
          moving the logic out of it, which is what the layering already
          requires.
        -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>coverage-agent</id>
              <phase>initialize</phase>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <!-- Not the default "argLine" property: see the surefire block
                     above for why the indirection matters. -->
                <propertyName>cometgui.jacocoArgLine</propertyName>
              </configuration>
            </execution>
            <execution>
              <!-- Declared before the two checks and in the same phase, so the
                   XML report the checks and scripts/build.sh read is always the
                   one this build produced. -->
              <id>coverage-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>coverage-check-core</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <skip>${cometgui.coverage.core.skip}</skip>
                <haltOnFailure>true</haltOnFailure>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.90</minimum>
                      </limit>
                      <limit>
                        <counter>BRANCH</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.85</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
            <execution>
              <id>coverage-check-viewmodel</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <skip>${cometgui.coverage.viewmodel.skip}</skip>
                <haltOnFailure>true</haltOnFailure>
                <rules>
                  <rule>
                    <!--
                      PACKAGE, not BUNDLE: the specification gives the 80% line
                      target to "UI-independent view-model and presenter logic",
                      not to the whole UI module, and the same module also holds
                      the JavaFX rendering glue the specification deliberately
                      leaves without a numeric target.  A BUNDLE rule here would
                      invent a number for the glue.

                      The pattern is matched against the name JaCoCo's check
                      goal gives the element, which for a package uses DOTS.
                      This was written with slashes first, on the reasonable
                      assumption that report element names are VM names; the
                      rule then matched nothing and passed over an uncovered
                      class without a word.  What caught it was the view-model
                      control in scripts/verify-test-gates.sh, which is the
                      whole argument for making an inert rule fail on purpose
                      before believing it.
                    -->
                    <element>PACKAGE</element>
                    <includes>
                      <include>org.cometgui.ui.viewmodel*</include>
                    </includes>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.80</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <!--
          UNIT 3: MUTATION TESTING (R-TEST-02).  "The gate is >= 80% mutation
          score in those packages, with no surviving mutation that can disable
          checksum verification, invert a q-value comparison, drop a required
          output, suppress a validation error, pass an unsupported option to a
          tool, or leak a secret."

          WHY PIT IS NOT IN THE DEFAULT `mvn verify`.  PIT re-runs the test
          suite once per mutation; on a full parameter parser that is minutes,
          not seconds, and a gate people are tempted to skip is a gate that
          rots.  It therefore has its own profile (-Pmutation, at the end of
          this POM), and scripts/build.sh runs the goal directly in its `gates`
          stage.  It is not optional: the build script fails if the run does not
          produce a report with real mutations in it.

          failWhenNoMutations IS LEFT AT ITS DEFAULT (true) ON PURPOSE.  Turning
          it off is the classic vacuous pass: PIT finds nothing to mutate, exits
          0, and the 80% gate is never evaluated.  The per-module switch
          cometgui.mutation.skip is how a module that genuinely has no critical
          code yet stays out, and scripts/build.sh re-derives from the compiled
          classes which modules should have it switched on.

          TARGET CLASSES: the specification's list of critical pure logic, in
          package terms.  A later phase adds its packages here and flips its own
          module's switch; it does not narrow this list.
        -->
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest-maven.version}</version>
          <dependencies>
            <!-- Without this PIT finds the JUnit 5 tests but cannot run them,
                 and reports every mutation as NO_COVERAGE. -->
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5-plugin.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <skip>${cometgui.mutation.skip}</skip>
            <mutationThreshold>80</mutationThreshold>
            <targetClasses>
              <!-- domain model: value objects, run and project state -->
              <param>org.cometgui.domain.*</param>
              <!-- Comet parameter schema, parser, writer, validation, presets,
                   migration -->
              <param>org.cometgui.params.comet.*</param>
              <!-- Percolator parameter schema and validation -->
              <param>org.cometgui.params.percolator.*</param>
              <!-- checksum and provenance code, secret redaction in reports -->
              <param>org.cometgui.provenance.*</param>
              <!-- q-value filters and result parsing -->
              <param>org.cometgui.results.filtering.*</param>
              <param>org.cometgui.results.parser.*</param>
              <!-- command builders, version and capability rules, secret
                   redaction in the process service -->
              <param>org.cometgui.tools.*</param>
              <!-- artefact selection, checksum verification, capability probe -->
              <param>org.cometgui.install.registry.*</param>
              <param>org.cometgui.install.verify.*</param>
              <param>org.cometgui.install.probe.*</param>
              <!-- stage invalidation rules -->
              <param>org.cometgui.workflow.state.*</param>
            </targetClasses>
            <targetTests>
              <param>org.cometgui.*</param>
            </targetTests>
            <outputFormats>
              <!-- XML because scripts/build.sh reads the mutation counts out of
                   it; HTML because a survivor has to be readable to be fixed. -->
              <param>XML</param>
              <param>HTML</param>
            </outputFormats>
            <timestampedReports>false</timestampedReports>
            <threads>4</threads>
          </configuration>
        </plugin>

        <!--
          ROOM RESERVED FOR LATER PHASE 01 WORK UNITS.  Add the plugin here,
          pinned by a property above, and its <executions> in <build><plugins>
          below.  Keeping the additions in separate blocks is deliberate: two
          agents can work on this file without colliding.

            unit 2  DONE: the three blocks above.
            unit 3  DONE: JaCoCo and PIT above; archunit-junit5 and the
                    headless JavaFX recipe are in the modules that use them
                    (cometgui-archtests and cometgui-ui).
            unit 7  SBOM and dependency scanning
                    org.cyclonedx:cyclonedx-maven-plugin
                    org.owasp:dependency-check-maven
        -->
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        A wrong toolchain must fail immediately and say so, not fail later
        with a confusing class-file or API error.  Bound to validate, so it is
        the first thing that runs in every module.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[${cometgui.minimumMavenVersion},)</version>
                  <message>CometGUI requires Apache Maven ${cometgui.minimumMavenVersion} or newer. Source tools/env.sh, or run scripts/feasibility/install-toolchain.sh if tools/ is missing.</message>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${cometgui.minimumJavaVersion},)</version>
                  <message>CometGUI requires a Java ${cometgui.minimumJavaVersion} JDK (pinned: BellSoft Liberica JDK 25.0.4.1+1, which bundles JavaFX). Source tools/env.sh.</message>
                </requireJavaVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        UNIT 2 executions.  Spotless and Checkstyle run at `validate`, before a
        single class is compiled, so a formatting or style failure costs
        seconds rather than a full build; SpotBugs runs at `verify`, because it
        needs the compiled classes.  All three therefore run inside
        `mvn verify`, which is what `bash scripts/build.sh` runs: no extra
        build stage invokes them, and none of them is optional.
        `mvn spotless:apply` fixes formatting and inserts the licence header.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotbugs-analyse-and-check</id>
            <phase>verify</phase>
            <goals>
              <!-- `spotbugs` writes target/spotbugsXml.xml, which is the
                   evidence that classes were really analysed; `check` reads it
                   and fails the build on any reported bug. -->
              <goal>spotbugs</goal>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        UNIT 3 executions.  The plugin is listed with no <executions> of its
        own: they come from pluginManagement above, which is where the
        thresholds live.  Coverage runs in every module (prepare-agent at
        initialize, report and the two checks at verify), so `mvn verify` is
        the whole local gate and no separate command is needed to enforce it.

        PIT is NOT here.  It is bound to verify only under -Pmutation, at the
        bottom of this file, and scripts/build.sh invokes its goal directly.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!-- unit 7 executions belong here. -->
    </plugins>
  </build>

  <!--
    UNIT 3.  `mvn -Pmutation verify` runs the whole build and then the mutation
    gate; that is the form a CI pipeline invokes.  scripts/build.sh instead
    calls org.pitest:pitest-maven:mutationCoverage directly against the classes
    the build already produced, because re-running verify to get to PIT would
    double the build.  Both paths read the same configuration from
    pluginManagement, so neither can drift into being the lenient one.
  -->
  <profiles>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>mutation-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
